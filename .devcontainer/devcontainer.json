{
  "name": "chatroom-codespace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "forwardPorts": [3001, 6379],
  "portsAttributes": {
    "3001": {
      "label": "chatroom",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "6379": {
      "label": "redis",
      "visibility": "private"
    }
  },
  "postCreateCommand": "bash .devcontainer/install-deps.sh",
  "postStartCommand": "bash .devcontainer/bootstrap.sh",
  "remoteEnv": {
    "NODE_ENV": "production",
    "PORT": "3001",
    "HOST": "0.0.0.0",
    "REDIS_URL": "redis://127.0.0.1:6379",
    "DATABASE_URL": "./data/chatroom.db"
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb"
  },
  "idleTimeout": 10,
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
