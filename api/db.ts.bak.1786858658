  `CREATE INDEX IF NOT EXISTS idx_messages_receiver ON messages(receiverId)`,
  `CREATE INDEX IF NOT EXISTS idx_messages_pair_ts ON messages(senderId, receiverId, timestamp DESC)`,
  `CREATE INDEX IF NOT EXISTS idx_friendships_user ON friendships(userId)`,
  `CREATE INDEX IF NOT EXISTS idx_friendships_friend ON friendships(friendId)`,
  `CREATE INDEX IF NOT EXISTS idx_verification_target_type ON verification_codes(target, type)`,
  `CREATE INDEX IF NOT EXISTS idx_posts_created ON posts(createdAt DESC)`,
  `CREATE INDEX IF NOT EXISTS idx_posts_user ON posts(userId)`,
  `CREATE INDEX IF NOT EXISTS idx_comments_post ON comments(postId)`,
  `CREATE INDEX IF NOT EXISTS idx_comments_post_created ON comments(postId, createdAt ASC)`,
  `CREATE INDEX IF NOT EXISTS idx_comments_parent ON comments(parentId)`,
  `CREATE INDEX IF NOT EXISTS idx_notifications_user ON notifications(userId, isRead)`,
  `CREATE INDEX IF NOT EXISTS idx_notifications_created ON notifications(userId, createdAt DESC)`,
  `CREATE INDEX IF NOT EXISTS idx_group_members_group ON group_members(groupId)`,
  `CREATE INDEX IF NOT EXISTS idx_group_members_user ON group_members(userId)`,
  `CREATE INDEX IF NOT EXISTS idx_group_messages_group_ts ON group_messages(groupId, timestamp DESC)`,
  `CREATE INDEX IF NOT EXISTS idx_unread_user ON unread_counts(userId)`,
  `CREATE UNIQUE INDEX IF NOT EXISTS idx_unread_user_target ON unread_counts(userId, targetType, targetId)`,
  `CREATE INDEX IF NOT EXISTS idx_group_invitations_invitee ON group_invitations(inviteeId, status)`,
  `CREATE INDEX IF NOT EXISTS idx_messages_ts ON messages(timestamp)`,
  `CREATE INDEX IF NOT EXISTS idx_group_messages_ts ON group_messages(timestamp)`,
];
for (const sql of INDEX_SQLS) { try { db.exec(sql); } catch {} }

const ALTER_SQLS = [
  `ALTER TABLE users ADD COLUMN deactivatedAt DATETIME DEFAULT NULL`,
  `ALTER TABLE users ADD COLUMN vip INTEGER DEFAULT 0`,
  `ALTER TABLE users ADD COLUMN vipExpiresAt DATETIME DEFAULT NULL`,
  `ALTER TABLE users ADD COLUMN wechatQrcode TEXT DEFAULT ''`,
  `ALTER TABLE users ADD COLUMN bio TEXT DEFAULT ''`,
  `ALTER TABLE users ADD COLUMN gender TEXT DEFAULT ''`,
  `ALTER TABLE users ADD COLUMN region TEXT DEFAULT ''`,
  `ALTER TABLE users ADD COLUMN faceDescriptor TEXT DEFAULT ''`,
  `ALTER TABLE users ADD COLUMN isOfficial INTEGER DEFAULT 0`,
  `ALTER TABLE users ADD COLUMN age INTEGER DEFAULT 0`,
  `ALTER TABLE comments ADD COLUMN parentId INTEGER DEFAULT NULL`,
  `ALTER TABLE comments ADD COLUMN replyToUserId INTEGER DEFAULT NULL`,
];
for (const sql of ALTER_SQLS) { try { db.exec(sql); } catch {} }

try { db.exec(`UPDATE users SET active = 1 WHERE active IS NULL`); } catch {}

(async () => {
  try {
    const officialExists = db.prepare('SELECT id FROM users WHERE isOfficial = 1').get();
    if (!officialExists) {
      let existing = db.prepare('SELECT id FROM users WHERE username = ?').get('ChatRoom');
      if (!existing) existing = db.prepare('SELECT id FROM users WHERE username = ?').get('chatroom');
      if (existing) {
        db.prepare('UPDATE users SET isOfficial = 1 WHERE id = ?').run(existing.id);
      } else {
        const bcryptMod = await import('bcryptjs');
        const bcrypt = (bcryptMod as any).default || bcryptMod;
        const hashed = bcrypt.hashSync('chatroom2026', 8);
        db.prepare('INSERT INTO users (username, password, email, bio, isOfficial, avatar) VALUES (?, ?, ?, ?, 1, ?)')
          .run('ChatRoom', hashed, 'official@chatroom.app', 'ChatRoom官方账号，欢迎关注！', '');
      }
      markDirty();
    }
  } catch (e: any) { console.error('[DB] init official:', e); }
})();

class StmtCache {
  private map = new Map<string, any>();
  private max = 64;
  get(sql: string): any {
    let s = this.map.get(sql);
    if (!s) {
      if (this.map.size >= this.max) {
        const keys = this.map.keys();
        for (let i = 0; i < this.max / 4; i++) {
          const k = keys.next();
          if (k.done) break;
          this.map.delete(k.value as string);
        }
      }
      s = db.prepare(sql);
      this.map.set(sql, s);
    }
    return s;
  }
}
export const stmtCache = new StmtCache();
export default db;
