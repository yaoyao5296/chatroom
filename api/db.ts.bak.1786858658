import initSqlJs from 'sql.js';
import path from 'path';
import { fileURLToPath } from 'url';
import fs from 'fs';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const dbPath = path.join(__dirname, '..', 'data', 'chat.db');

const dataDir = path.dirname(dbPath);
if (!fs.existsSync(dataDir)) {
  fs.mkdirSync(dataDir, { recursive: true });
}

let SQL: any;
let _db: any;

function loadDb(): any {
  if (_db) return _db;
  const fileBuffer = fs.existsSync(dbPath) ? fs.readFileSync(dbPath) : undefined;
  _db = new SQL.Database(fileBuffer);
  return _db;
}

let saveTimer: any = null;
let dirty = false;
function markDirty() {
  dirty = true;
  if (!saveTimer) {
    saveTimer = setTimeout(() => {
      if (dirty && _db) {
        try {
          const data = _db.export();
          const tmp = dbPath + '.tmp';
          fs.writeFileSync(tmp, Buffer.from(data));
          fs.renameSync(tmp, dbPath);
          dirty = false;
        } catch (e: any) {
          console.error('[DB] save error:', e);
        }
      }
      saveTimer = null;
    }, 1500);
  }
}
function forceSave() {
  if (_db && dirty) {
    try {
      const data = _db.export();
      const tmp = dbPath + '.tmp';
      fs.writeFileSync(tmp, Buffer.from(data));
      fs.renameSync(tmp, dbPath);
      dirty = false;
    } catch {}
  }
}
process.on('exit', forceSave);
process.on('SIGTERM', () => { forceSave(); process.exit(0); });
process.on('SIGINT', () => { forceSave(); process.exit(0); });

class Statement {
  private _sql: string;
  constructor(sql: string) { this._sql = sql; }
  run(...args: any[]): { changes: number; lastInsertRowid: any } {
    const d = loadDb();
    d.run(this._sql, args);
    markDirty();
    const changes = (typeof d.getRowsModified === 'function') ? d.getRowsModified() : 0;
    let lid = 0;
    try {
      const r = d.exec('SELECT last_insert_rowid() AS id');
      if (r && r[0] && r[0].values && r[0].values[0]) lid = r[0].values[0][0];
    } catch {}
    return { changes, lastInsertRowid: lid };
  }
  get(...args: any[]): any {
    const d = loadDb();
    try {
      const s = d.prepare(this._sql);
      s.bind(args);
      if (s.step()) {
        const row = s.getAsObject();
        s.free();
        return row;
      }
      s.free();
    } catch {}
    return undefined;
  }
  all(...args: any[]): any[] {
    const d = loadDb();
    const rows: any[] = [];
    try {
      const s = d.prepare(this._sql);
      s.bind(args);
      while (s.step()) rows.push(s.getAsObject());
      s.free();
    } catch {}
    return rows;
  }
  pluck(): this {
    const origGet = this.get.bind(this);
    const origAll = this.all.bind(this);
    this.get = (...a: any[]) => {
      const r = origGet(...a);
      if (r == null) return r;
      const k = Object.keys(r as any);
      return (r as any)[k[0]];
    };
    this.all = (...a: any[]) => origAll(...a).map((r: any) => {
      const k = Object.keys(r);
      return r[k[0]];
    });
    return this;
  }
}

class DatabaseCompat {
  exec(sql: string): void { loadDb().exec(sql); markDirty(); }
  pragma(sql: string): any {
    try {
      const lower = sql.trim().toLowerCase();
      if (lower.startsWith('journal_mode') || lower.startsWith('synchronous')
        || lower.startsWith('cache_size') || lower.startsWith('mmap_size')
        || lower.startsWith('temp_store') || lower.startsWith('busy_timeout')
        || lower.startsWith('wal_autocheckpoint') || lower.startsWith('journal_size_limit')
        || lower.startsWith('optimize') || lower.startsWith('case_sensitive_like')) {
        return [];
      }
      const key = lower.split('=')[0].trim();
      return loadDb().exec('PRAGMA ' + key);
    } catch { return []; }
  }
  prepare(sql: string): Statement { return new Statement(sql); }
  transaction(fn: any): any {
    return function(...args: any[]) {
      loadDb().exec("BEGIN");
      try {
        const res = fn.apply(null, args);
        loadDb().exec("COMMIT");
        markDirty();
        return res;
      } catch (e) {
        try { loadDb().exec("ROLLBACK"); } catch {}
        throw e;
      }
    };
  }
      try { forceSave(); if (fs.existsSync(dbPath)) fs.copyFileSync(dbPath, dest); resolve(); }
      catch (e) { reject(e); }
    });
  }
}

await (async () => { SQL = await initSqlJs(); loadDb(); })();
const db: any = new DatabaseCompat();

db.exec(`CREATE TABLE IF NOT EXISTS users (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  username TEXT UNIQUE NOT NULL,
  password TEXT NOT NULL,
  phone TEXT DEFAULT '',
